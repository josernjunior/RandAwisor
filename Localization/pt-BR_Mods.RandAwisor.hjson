Items: {
	DirtBreastplate: {
		DisplayName: Peitoral de Terra
		Tooltip: Tem cheiro de dia chuvoso.
	}

	DirtHelmet: {
		DisplayName: Capacete de Terra
		Tooltip: Mantém sua cabeça com os pés no chão.
	}

	DirtLeggings: {
		DisplayName: Calças de Terra
		Tooltip: Coçam um pouquinho.
	}

	DirtSword: {
		DisplayName: Espada de Terra
		Tooltip: Feita de terra 100% orgânica.
	}
}

Configs: {
	RandomizerConfig: {
		DisplayName: Randomizador de IA

		Headers: {
			Behavior: Comportamento dos NPCs
			AIStyles: Estilos de IA
		}

		AIMode: {
			Label: Modo
			Tooltip:
				'''
				Desligado: todo NPC mantém a própria IA.
				Trocar por tipo: cada tipo de NPC sempre age como outro tipo de NPC (fixo pela seed).
				Aleatório por NPC: cada NPC que aparece ganha um comportamento aleatório.
				'''
		}

		Seed: {
			Label: Seed
			Tooltip:
				'''
				Número (ou qualquer texto) que decide quem age como quem no modo Trocar por tipo.
				A mesma seed sempre gera as mesmas trocas. Deixe vazio para usar a seed do mundo.
				'''
		}

		AffectHostiles: {
			Label: Aleatorizar inimigos
			Tooltip: ""
		}

		AffectTownNPCs: {
			Label: Aleatorizar NPCs da cidade
			Tooltip: O Guia, o Mercador e os outros moradores.
		}

		AffectCritters: {
			Label: Aleatorizar bichinhos
			Tooltip: Coelhos, pássaros, borboletas e afins.
		}

		AIStyles: {
			Label: IAs ativadas
			Tooltip: Uma IA desativada nunca é sorteada; o NPC que a receberia fica com o próximo sorteio da seed.
		}
	}

