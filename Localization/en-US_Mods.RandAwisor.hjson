# This file will automatically update with entries for new content after a build and reload.
# Please read https://github.com/tModLoader/tModLoader/wiki/Localization to learn more about localization and these files.

Items: {
	DirtBreastplate: {
		DisplayName: Dirt Breastplate
		Tooltip: Smells like a rainy day.
	}

	DirtHelmet: {
		DisplayName: Dirt Helmet
		Tooltip: Keeps your head grounded.
	}

	DirtLeggings: {
		DisplayName: Dirt Leggings
		Tooltip: A little itchy.
	}

	DirtSword: {
		DisplayName: Dirt Sword
		Tooltip: Made from 100% organic dirt.
	}
}

Configs: {
	RandomizerConfig: {
		DisplayName: AI Randomizer

		Headers: {
			Behavior: NPC behavior
			AIStyles: AI styles
			AdditionalAIs: Additional AIs
		}

		AIMode: {
			Label: Mode
			Tooltip:
				'''
				Off: every NPC keeps its own AI.
				Shuffle by type: each NPC type always behaves like one other NPC type (fixed by the seed).
				Random per NPC: each NPC that spawns gets its own draw from the seed. Town NPCs keep theirs when the world is reloaded.
				'''
		}

		Seed: {
			Label: Seed
			Tooltip:
				'''
				Number (or any text) that decides every behavior the randomizer hands out, in both modes.
				The same seed always gives the same results. Numbers too big for an integer are wrapped into range. Leave it empty to use the world's seed.
				'''
		}

		AffectHostiles: {
			Label: Randomize enemies
			Tooltip: ""
		}

		AffectTownNPCs: {
			Label: Randomize town NPCs
			Tooltip: The Guide, the Merchant and the other town NPCs.
		}

		AffectCritters: {
			Label: Randomize critters
			Tooltip: Bunnies, birds, butterflies and the like.
		}

		AIStyles: {
			Label: Enabled AI styles
			Tooltip: A disabled AI is never handed out; an NPC that would get it takes the seed's next draw instead.
		}

		EnableAdditionalAIs: {
			Label: Use additional AIs
			Tooltip: The mod's own 50 behaviors join the draw alongside the game's AIs.
		}

		AdditionalAIChance: {
			Label: Additional AI chance (%)
			Tooltip: Share of draws that pick one of the additional AIs instead of one of the game's.
		}

		AdditionalAIs: {
			Label: Enabled additional AIs
			Tooltip: A disabled AI is never handed out; an NPC that would get it takes the seed's next draw instead.
		}
	}

	AIStyleToggles: {
